@page "/configuracoes"
@inject AppDbContext Db
@inject SatoPrinterService Printer

<PageTitle>Configurações</PageTitle>

<h5 class="mb-3">Configurações</h5>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white">Impressora Sato C4LX</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Como conectar à impressora?</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="tipoConexao" id="conRede"
                               checked="@(_params.TipoConexao == 1)" @onchange="() => _params.TipoConexao = 1" />
                        <label class="btn btn-outline-primary" for="conRede">
                            <i class="bi bi-ethernet me-1"></i>Rede (cabo Ethernet)
                        </label>

                        <input type="radio" class="btn-check" name="tipoConexao" id="conCom"
                               checked="@(_params.TipoConexao == 0)" @onchange="() => _params.TipoConexao = 0" />
                        <label class="btn btn-outline-primary" for="conCom">
                            <i class="bi bi-usb-symbol me-1"></i>USB (porta COM)
                        </label>
                    </div>
                    <div class="form-text">Recomendado: <strong>Rede</strong> — mais estável.</div>
                </div>

                @if (_params.TipoConexao == 1)
                {
                    <div class="mb-3">
                        <label class="form-label">IP da impressora</label>
                        <input class="form-control" @bind="_params.ImpressoraIp" placeholder="192.168.1.100" />
                        <div class="form-text">
                            O IP aparece no painel da impressora ou no relatório de configuração.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Porta TCP</label>
                        <input type="number" class="form-control" @bind="_params.ImpressoraPorta" />
                        <div class="form-text">A Sato usa <strong>9100</strong> por padrão. Não mude se não souber.</div>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label">Porta COM</label>
                        <div class="input-group">
                            <select class="form-select" @bind="_params.PortaCom">
                                @foreach (var p in _portas)
                                {
                                    <option value="@p">@p</option>
                                }
                            </select>
                            <button class="btn btn-outline-secondary" @onclick="AtualizarPortas">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>
                        <div class="form-text">Portas disponíveis: @string.Join(", ", _portas)</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Baud Rate</label>
                        <select class="form-select" @bind="_params.BaudRate">
                            <option value="9600">9600</option>
                            <option value="19200">19200</option>
                            <option value="38400">38400</option>
                            <option value="115200">115200</option>
                        </select>
                    </div>
                }

                <button class="btn btn-outline-success w-100" @onclick="TestarConexao" disabled="@_testando">
                    @if (_testando)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    else
                    {
                        <i class="bi bi-plug me-1"></i>
                    }
                    Testar conexão
                </button>
                @if (!string.IsNullOrEmpty(_testeMsg))
                {
                    <div class="alert @(_testeOk ? "alert-success" : "alert-danger") py-2 mt-2 mb-0 small">
                        @_testeMsg
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white">Servidor AfixData (opcional)</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">IP do servidor</label>
                    <input class="form-control" @bind="_params.ServidorIp" placeholder="192.168.1.100" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Porta</label>
                    <input class="form-control" @bind="_params.ServidorPorta" placeholder="8080" />
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <button class="btn btn-warning" @onclick="Salvar">
            <i class="bi bi-check-lg me-1"></i>Salvar configurações
        </button>
        @if (!string.IsNullOrEmpty(_msg))
        {
            <span class="ms-3 text-success"><i class="bi bi-check-circle me-1"></i>@_msg</span>
        }
    </div>

    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white">Referência RFID EPC — Capacidade por tamanho</div>
            <div class="card-body">
                <table class="table table-sm small mb-0">
                    <thead><tr><th>Tamanho EPC</th><th>Bytes</th><th>Máx. chars ASCII</th><th>Uso típico</th></tr></thead>
                    <tbody>
                        <tr><td>96 bits</td><td>12</td><td>12 caracteres</td><td>Padrão Gen2 (maioria das tags)</td></tr>
                        <tr><td>128 bits</td><td>16</td><td>16 caracteres</td><td>Tags EPC Class 1 Gen 2 extendido</td></tr>
                        <tr><td>192 bits</td><td>24</td><td>24 caracteres</td><td>Tags com memória EPC grande</td></tr>
                        <tr><td>256 bits</td><td>32</td><td>32 caracteres</td><td>Tags de alta memória</td></tr>
                    </tbody>
                </table>
                <div class="mt-2 small text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    O bug original ocorria porque o app tentava gravar dados com mais de 12 chars ASCII
                    num EPC de 96 bits sem aviso. Agora o sistema exibe aviso e permite escolher o tamanho correto.
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private RfidEtiquetas.Data.Models.Parametros _params = new();
    private string[] _portas = [];
    private string _msg = "";
    private bool _testando;
    private bool _testeOk;
    private string _testeMsg = "";

    protected override void OnInitialized()
    {
        _params = Db.GetParametros();
        AtualizarPortas();
    }

    private void AtualizarPortas()
    {
        _portas = Printer.ListarPortas();
        if (_portas.Length > 0 && !_portas.Contains(_params.PortaCom))
            _params.PortaCom = _portas[0];
    }

    private void Salvar()
    {
        Db.SaveParametros(_params);
        _msg = "Salvo!";
    }

    private async Task TestarConexao()
    {
        _testando = true; _testeMsg = ""; StateHasChanged();
        var r = await Task.Run(() => Printer.TestarConexao(_params));
        _testando = false;
        _testeOk = r.Sucesso;
        _testeMsg = r.Sucesso
            ? "Conexão OK! A impressora respondeu."
            : $"Falha na conexão: {r.Erro}";
    }
}
