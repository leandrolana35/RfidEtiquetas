@page "/usuarios"
@attribute [Authorize(Roles = "Administrador")]
@inject AppDbContext Db
@inject UserManager<Usuario> UserManager

<PageTitle>Usuários</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Usuários</h5>
    <button class="btn btn-warning" @onclick="Novo"><i class="bi bi-plus-lg me-1"></i>Novo usuário</button>
</div>

@if (_editando)
{
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label small">Nome</label>
                    <input class="form-control" @bind="_nome" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small">E-mail</label>
                    <input class="form-control" @bind="_email" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small">Senha</label>
                    <input type="password" class="form-control" @bind="_senha" placeholder="Mínimo 6 caracteres" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small">Perfil</label>
                    <select class="form-select" @bind="_perfil">
                        <option value="@Perfil.Usuario">Usuário</option>
                        <option value="@Perfil.Administrador">Administrador</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small">Empresa</label>
                    <select class="form-select" @bind="_empresaId">
                        <option value="0">-- Selecione --</option>
                        @foreach (var emp in _empresas)
                        {
                            <option value="@emp.Id">@emp.Nome</option>
                        }
                    </select>
                </div>
                <div class="col-12 d-flex gap-2 mt-2">
                    <button class="btn btn-warning" @onclick="Salvar">Salvar</button>
                    <button class="btn btn-outline-secondary" @onclick="() => _editando = false">Cancelar</button>
                </div>
                @if (!string.IsNullOrEmpty(_mensagem))
                {
                    <div class="col-12"><div class="alert alert-danger py-2 small mb-0">@_mensagem</div></div>
                }
            </div>
        </div>
    </div>
}

<table class="table table-sm bg-white shadow-sm">
    <thead><tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Empresa</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var u in _lista)
        {
            <tr>
                <td>@u.Nome</td>
                <td>@u.Email</td>
                <td>@u.Perfil</td>
                <td>@(_empresas.FirstOrDefault(e => e.Id == u.EmpresaId)?.Nome)</td>
                <td>@(u.Ativo ? "Ativo" : "Inativo")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Usuario> _lista = [];
    private List<Empresa> _empresas = [];
    private bool _editando;
    private string _nome = "";
    private string _email = "";
    private string _senha = "";
    private Perfil _perfil = Perfil.Usuario;
    private int _empresaId;
    private string _mensagem = "";

    protected override void OnInitialized()
    {
        _lista = Db.Users.ToList();
        _empresas = Db.GetEmpresas();
    }

    private void Novo()
    {
        _nome = ""; _email = ""; _senha = ""; _perfil = Perfil.Usuario; _empresaId = 0;
        _mensagem = ""; _editando = true;
        _empresas = Db.GetEmpresas();
    }

    private async Task Salvar()
    {
        if (string.IsNullOrWhiteSpace(_nome) || string.IsNullOrWhiteSpace(_email) || _empresaId == 0)
        {
            _mensagem = "Preencha nome, e-mail e empresa.";
            return;
        }

        var usuario = new Usuario
        {
            UserName = _email,
            Email = _email,
            Nome = _nome,
            Perfil = _perfil,
            EmpresaId = _empresaId
        };

        var resultado = await UserManager.CreateAsync(usuario, _senha);
        if (!resultado.Succeeded)
        {
            _mensagem = string.Join("; ", resultado.Errors.Select(e => e.Description));
            return;
        }

        _editando = false;
        _lista = Db.Users.ToList();
    }
}
