@inject NavigationManager Nav

@code {
    // Precisa de forceLoad porque /login é uma Razor Page fora do SPA do Blazor
    // (login tem que gravar cookie via HttpContext, o que não é possível de
    // dentro de um componente Blazor Server já conectado por SignalR).
    protected override void OnInitialized()
    {
        // Precisa ser um caminho relativo (não a URL absoluta) — LocalRedirect
        // no Login.cshtml.cs rejeita URLs com host/esquema por segurança.
        var caminhoRelativo = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(caminhoRelativo)}", forceLoad: true);
    }
}
