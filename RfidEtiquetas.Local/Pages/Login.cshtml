@page
@model RfidEtiquetas.Local.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — AfixRFID Etiquetas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex align-items-center" style="min-height:100vh">
    <div class="container" style="max-width:380px">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h5 class="mb-3 text-center">AfixRFID Etiquetas</h5>
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">E-mail</label>
                        <input asp-for="Email" class="form-control" autofocus />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Senha</label>
                        <input asp-for="Senha" type="password" class="form-control" />
                    </div>
                    @if (Model.Erro != null)
                    {
                        <div class="alert alert-danger py-2 small">@Model.Erro</div>
                    }
                    <button class="btn btn-warning w-100" type="submit">Entrar</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
