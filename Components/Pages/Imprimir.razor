@page "/imprimir"
@inject AppDbContext Db
@inject SatoPrinterService Printer
@inject RfidEncoderService RfidEncoder
@inject BarcodeService Barcode

<PageTitle>Imprimir Etiqueta</PageTitle>

<h5 class="mb-3">Imprimir Etiqueta RFID</h5>

<div class="row g-3">
    <!-- Configuração de impressão -->
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white">Configuração</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Modelo de etiqueta</label>
                    <select class="form-select" @bind="_modeloId" @bind:after="OnModeloChanged">
                        <option value="0">-- Selecione --</option>
                        @foreach (var e in _modelos)
                        {
                            <option value="@e.Id">@e.Modelo</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Impressora</label>
                    <div class="form-control bg-light d-flex justify-content-between align-items-center">
                        <span>
                            @if (_params.TipoConexao == 1)
                            {
                                <i class="bi bi-ethernet me-1 text-primary"></i>
                                <span>Rede — @_params.ImpressoraIp:@_params.ImpressoraPorta</span>
                            }
                            else
                            {
                                <i class="bi bi-usb-symbol me-1 text-primary"></i>
                                <span>USB — @_params.PortaCom</span>
                            }
                        </span>
                        <a href="configuracoes" class="small text-decoration-none">alterar</a>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Código de barras</label>
                    <input class="form-control" @bind="_codigoBarras" @bind:event="oninput" @bind:after="AtualizarPreview" placeholder="Digite o código" />
                </div>

                @if (_modelo?.RfidAtivo == true)
                {
                    <div class="mb-3">
                        <label class="form-label d-flex justify-content-between">
                            <span>Dado RFID <span class="badge bg-success">EPC</span></span>
                            <small class="text-muted">@_rfidInfo</small>
                        </label>
                        <input class="form-control @(_rfidAviso != null ? "border-warning" : "")"
                               @bind="_dadoRfid" @bind:event="oninput" @bind:after="AtualizarRfidInfo"
                               placeholder="Texto ou número para gravar na tag" />
                        @if (_rfidAviso != null)
                        {
                            <div class="form-text text-warning">
                                <i class="bi bi-exclamation-triangle me-1"></i>@_rfidAviso
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_dadoRfid) && _rfidAviso == null)
                        {
                            <div class="form-text text-muted font-monospace">
                                HEX: @_rfidHex
                            </div>
                        }
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Quantidade</label>
                    <input type="number" class="form-control" @bind="_quantidade" min="1" max="9999" />
                </div>

                <button class="btn btn-warning w-100" @onclick="ExecutarImpressao" disabled="@(_modeloId == 0 || _imprimindo)">
                    @if (_imprimindo)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    else
                    {
                        <i class="bi bi-printer me-2"></i>
                    }
                    Imprimir @_quantidade etiqueta@(_quantidade > 1 ? "s" : "")
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_resultado))
        {
            <div class="alert @(_resultadoErro ? "alert-danger" : "alert-success") mt-3 py-2">
                @_resultado
            </div>
        }
    </div>

    <!-- Preview -->
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white">
                <i class="bi bi-eye me-1"></i>Preview da etiqueta
            </div>
            <div class="card-body">
                @if (_modelo == null)
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-layout-text-sidebar fs-1"></i>
                        <p>Selecione um modelo para ver o preview</p>
                    </div>
                }
                else
                {
                    <div class="label-preview position-relative bg-white border"
                         style="width:100%;aspect-ratio:@_modelo.LarguraMm/@_modelo.AlturaMm;max-height:280px;overflow:hidden">

                        @if (!string.IsNullOrEmpty(_modelo.Texto1))
                        {
                            <div style="position:absolute;left:@(_modelo.Texto1X / 10)%;top:@(_modelo.Texto1Y / 10)%;font-size:@(_modelo.Texto1Tam)px;white-space:nowrap">
                                @_modelo.Texto1
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_modelo.Texto2))
                        {
                            <div style="position:absolute;left:@(_modelo.Texto2X / 10)%;top:@(_modelo.Texto2Y / 10)%;font-size:@(_modelo.Texto2Tam)px;white-space:nowrap">
                                @_modelo.Texto2
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_modelo.Texto3))
                        {
                            <div style="position:absolute;left:@(_modelo.Texto3X / 10)%;top:@(_modelo.Texto3Y / 10)%;font-size:@(_modelo.Texto3Tam)px;white-space:nowrap">
                                @_modelo.Texto3
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_modelo.Texto4))
                        {
                            <div style="position:absolute;left:@(_modelo.Texto4X / 10)%;top:@(_modelo.Texto4Y / 10)%;font-size:@(_modelo.Texto4Tam)px;white-space:nowrap">
                                @_modelo.Texto4
                            </div>
                        }

                        @if (_modelo.BarImprimir && !string.IsNullOrEmpty(_barcodeBase64))
                        {
                            <div style="position:absolute;left:@(_modelo.BarCodX / 10)%;top:@(_modelo.BarCodY / 10)%">
                                <img src="@_barcodeBase64" style="height:@(_modelo.BarAltura / 3)px" />
                            </div>
                        }
                    </div>

                    <div class="mt-3">
                        <div class="small text-muted fw-semibold mb-1">Comando ZPL que será enviado à impressora:</div>
                        <pre class="bg-dark text-light p-2 rounded small" style="max-height:120px;overflow:auto">@_sbplPreview</pre>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public int modeloId { get; set; }

    private List<RfidEtiquetas.Data.Models.Etiqueta> _modelos = [];
    private RfidEtiquetas.Data.Models.Etiqueta? _modelo;
    private RfidEtiquetas.Data.Models.Parametros _params = new();
    private int _modeloId;
    private string _codigoBarras = "";
    private string _dadoRfid = "";
    private int _quantidade = 1;
    private bool _imprimindo;
    private string _resultado = "";
    private bool _resultadoErro;
    private string _barcodeBase64 = "";
    private string _sbplPreview = "";
    private string _rfidHex = "";
    private string? _rfidAviso;
    private string _rfidInfo = "";

    protected override void OnInitialized()
    {
        _modelos = Db.GetEtiquetas();
        _params = Db.GetParametros();

        if (modeloId > 0)
        {
            _modeloId = modeloId;
            OnModeloChanged();
        }
    }

    private void OnModeloChanged()
    {
        _modelo = _modeloId > 0 ? Db.GetEtiqueta(_modeloId) : null;
        if (_modelo != null)
        {
            _quantidade = _modelo.Quantidade;
            AtualizarPreview();
        }
    }

    private void AtualizarPreview()
    {
        if (_modelo == null) return;

        if (!string.IsNullOrEmpty(_codigoBarras))
            _barcodeBase64 = Barcode.GerarBase64(_modelo.BarPrefixo + _codigoBarras + _modelo.BarSufixo, _modelo.BarTipo);

        AtualizarRfidInfo();
        _sbplPreview = Printer.GerarSbplPreview(_modelo, _codigoBarras, _dadoRfid);
    }

    private void AtualizarRfidInfo()
    {
        if (_modelo == null || !_modelo.RfidAtivo || string.IsNullOrEmpty(_dadoRfid))
        {
            _rfidAviso = null; _rfidHex = ""; _rfidInfo = "";
            return;
        }

        var encoding = (RfidEncoderService.EncodingTipo)_modelo.RfidEncodingTipo;
        var resultado = RfidEncoder.Codificar(_modelo.RfidPrefixo + _dadoRfid, _modelo.RfidTamanhoBits, encoding);
        _rfidHex = resultado.HexData;
        _rfidAviso = resultado.Aviso;

        int bitsNecessarios = RfidEncoder.CalcularBitsNecessarios(_modelo.RfidPrefixo + _dadoRfid, encoding);
        _rfidInfo = $"{bitsNecessarios}/{_modelo.RfidTamanhoBits} bits";
    }

    private async Task ExecutarImpressao()
    {
        if (_modelo == null) return;
        _imprimindo = true; _resultado = ""; StateHasChanged();

        _modelo.Quantidade = _quantidade;
        var resultado = await Task.Run(() =>
            Printer.Imprimir(_modelo, _codigoBarras, _dadoRfid, _params));

        _imprimindo = false;
        _resultadoErro = !resultado.Sucesso;
        var destino = _params.TipoConexao == 1 ? $"{_params.ImpressoraIp}:{_params.ImpressoraPorta}" : _params.PortaCom;
        _resultado = resultado.Sucesso
            ? $"Impressão enviada com sucesso para {destino}."
            : $"Erro: {resultado.Erro}";

        if (resultado.AvisoRfid != null)
            _resultado += $"\nAviso RFID: {resultado.AvisoRfid}";
    }
}
